# syntax=docker/dockerfile:1.7
# ==============================================================================
# Stage 1: Dependencies & Workspace Prune
# ==============================================================================
FROM node:22-alpine3.20 AS deps

RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/ ./packages/
COPY apps/ ./apps/

RUN pnpm install --frozen-lockfile --prefer-offline || pnpm install

# ==============================================================================
# Stage 2: Nuxt 4 / Nitro Production Builder
# ==============================================================================
FROM deps AS builder

ARG APP_NAME=web
ENV NODE_ENV=production \
    NITRO_PRESET=node-server

RUN pnpm --filter @gvp/${APP_NAME} build

# ==============================================================================
# Stage 3: Hardened Non-Root Nitro Runtime
# ==============================================================================
FROM node:22-alpine3.20 AS runtime

ARG APP_NAME=web
ENV NODE_ENV=production \
    NITRO_PRESET=node-server \
    HOST=0.0.0.0 \
    PORT=3000

RUN apk add --no-cache dumb-init wget && \
    addgroup -g 10001 -S gvp && \
    adduser -u 10001 -S gvp -G gvp -h /app -s /sbin/nologin

WORKDIR /app

COPY --from=builder --chown=gvp:gvp /workspace/apps/${APP_NAME}/.output /app/.output

USER 10001:10001

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/ || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "/app/.output/server/index.mjs"]

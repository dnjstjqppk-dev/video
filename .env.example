# =============================================================================
# Global Video Platform — Environment Template
# Copy to .env (root) or export per service. NEVER commit real secrets.
# =============================================================================

# --- Go API (services/api) ---
PORT=8080
GVP_ENV=development
# Comma-separated test tokens in non-production: name:role pairs.
# Production MUST leave GVP_ALLOW_DEV_TOKENS unset/false.
GVP_ALLOW_DEV_TOKENS=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gvp?sslmode=disable
JWT_SECRET=change-me-to-a-32-plus-char-secret

# --- Object storage (uploads: S3 multipart via Cloudflare R2 or MinIO) ---
# When R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY are set, the API runs S3 mode.
# Otherwise it relays chunk bytes locally (GVP_LOCAL_MEDIA_DIR).
R2_ENDPOINT=http://localhost:9002
R2_PUBLIC_ENDPOINT=http://localhost:9002
R2_ACCESS_KEY_ID=gvp_r2_local_key
R2_SECRET_ACCESS_KEY=gvp_r2_local_secret
R2_BUCKET_RAW=gvp-raw-uploads
R2_BUCKET_HLS=gvp-public-hls
R2_REGION=auto
GVP_LOCAL_MEDIA_DIR=./var/media

# --- OIDC / Auth (ZITADEL or compatible, RS256 JWKS) ---
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_JWKS_URL=https://auth.example.com/oauth/v2/keys
# Nuxt server-side OIDC client (per console; same values unless split clients)
NUXT_OIDC_ISSUER=https://auth.example.com
NUXT_OIDC_CLIENT_ID=gvp-web
NUXT_OIDC_CLIENT_SECRET=change-me

# --- Nuxt consoles (apps/web|studio|partners|admin) ---
NUXT_INTERNAL_API_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_PUBLIC_WS_BASE_URL=ws://localhost:8081
NITRO_PRESET=node-server

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
TOSS_SECRET_KEY=test_sk_change_me

# --- Caching / Streaming / Search / Analytics ---
VALKEY_ADDR=localhost:6379
NATS_URL=nats://localhost:4222
OPENSEARCH_URL=http://localhost:9200
CLICKHOUSE_DSN=http://gvp_ch:gvp_ch_secret@localhost:8123/gvp_analytics

# --- Admin hardening ---
GVP_ADMIN_WHITELIST_CIDR=127.0.0.1/32,::1/128
GVP_TOTP_ISSUER=StreamVerse

# --- Compose overrides ---
POSTGRES_USER=gvp_admin
POSTGRES_PASSWORD=gvp_secret_dev_password
POSTGRES_DB=gvp_core
CLICKHOUSE_PASSWORD=gvp_ch_secret
GF_SECURITY_ADMIN_PASSWORD=gvp_grafana_secret
